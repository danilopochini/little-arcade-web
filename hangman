import random
from wordfreq import top_n_list

COMMON_WORDS = [
    word.upper()
    for word in top_n_list("en", 1000)
    if word.isascii() and word.isalpha() and 4 <= len(word) <= 9
]
MAX_WRONG_GUESSES = 10

HANGMAN_STAGES = [
    """
      +---+
      |   |
          |
          |
          |
          |
     =========
    """,
    """
      +---+
      |   |
      O   |
          |
          |
          |
     =========
    """,
    """
      +---+
      |   |
      O   |
      |   |
          |
          |
     =========
    """,
    """
      +---+
      |   |
      O   |
     /|   |
          |
          |
     =========
    """,
    """
      +---+
      |   |
      O   |
     /|\\  |
          |
          |
     =========
    """,
    """
      +---+
      |   |
      O   |
     /|\\  |
     /    |
          |
     =========
    """,
    """
      +---+
      |   |
      O   |
     /|\\  |
     / \\ |
          |
     =========
    """,
]


def choose_word():
    return random.choice(COMMON_WORDS)


def reveal_word(secret_word, guessed_letters):
    return " ".join(letter if letter in guessed_letters else "_" for letter in secret_word)


def get_player_guess(used_letters):
    while True:
        guess = input("Guess a letter (or type 'quit' to reveal the word): ").strip().upper()
        if guess == "QUIT":
            return None
        if len(guess) != 1 or not guess.isalpha():
            print("Please enter a single letter.")
            continue
        if guess in used_letters:
            print(f"You already guessed '{guess}'. Try another letter.")
            continue
        return guess


def play_round():
    secret_word = choose_word()
    guessed_letters = set()
    wrong_guesses = 0

    print("Welcome to Hangman!")
    print(f"Try to guess the hidden word. You have {MAX_WRONG_GUESSES} incorrect guesses.")

    while wrong_guesses < MAX_WRONG_GUESSES:
        print(HANGMAN_STAGES[min(wrong_guesses, len(HANGMAN_STAGES) - 1)])
        print(f"Word: {reveal_word(secret_word, guessed_letters)}")

        if set(secret_word).issubset(guessed_letters):
            print("You won! The word was:", secret_word)
            return True

        used_letters = ", ".join(sorted(guessed_letters)) if guessed_letters else "None"
        print(f"Used letters: {used_letters}")

        guess = get_player_guess(guessed_letters)
        if guess is None:
            print("You quit! The word was:", secret_word)
            return False
        guessed_letters.add(guess)

        if guess in secret_word:
            print(f"Correct! '{guess}' is in the word.")
        else:
            wrong_guesses += 1
            print(f"Wrong guess! '{guess}' is not in the word.")

    print(HANGMAN_STAGES[-1])
    print("Game over! The word was:", secret_word)
    return False


def main():
    while True:
        play_round()
        again = input("Would you like to play again? (y/n): ").strip().lower()
        if again != "y":
            print("Thanks for playing!")
            break


if __name__ == "__main__":
    main()
