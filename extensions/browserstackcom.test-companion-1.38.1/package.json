					"command": "test-companion.addToChat",
					"group": "navigation",
					"when": "editorHasSelection"
				}
			],
			"terminal/context": [
				{
					"command": "test-companion.addTerminalOutputToChat",
					"group": "navigation"
				}
			],
			"scm/title": [],
			"commandPalette": [
				{
					"command": "test-companion.dev.previewNotification",
					"when": "test-companion.isDevMode"
				},
				{
					"command": "test-companion.dev.simulateNotificationEvent",
					"when": "test-companion.isDevMode"
				},
