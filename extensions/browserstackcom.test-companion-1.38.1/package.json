					"when": "test-companion.isDevMode"
				},
				{
					"command": "test-companion.dev.showActivityBadge",
					"when": "test-companion.isDevMode"
				}
			]
		},
		"configuration": {
			"title": "Test Companion",
			"properties": {
				"testCompanion.subagentMaxConcurrency": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 4,
					"markdownDescription": "Maximum number of bulk test sub-agents to run concurrently (STM-1419). `0` lets Test Companion derive the limit from your machine (memory and CPU). A value of `1` forces sequential execution. This can only lower the machine-derived limit, never raise it past the safe ceiling. Has no effect unless bulk parallel execution is enabled for your account."
				},
				"testCompanion.maxConcurrentBrowserProfiles": {
					"type": "number",
					"default": 5,
					"minimum": 1,
					"maximum": 10,
					"markdownDescription": "STM-1713: hard cap on the total number of isolated browser profiles (contexts) open at once in a single run. The always-present `default` profile counts toward this, so a value of `5` allows the default session plus up to 4 additional named users. Opening one beyond the cap is rejected so the AI can retry with fewer users. Capped at a hard ceiling of 10 for memory safety. Has no effect on single-user tests."
				},
				"testCompanion.postEditLintGateMode": {
					"type": "string",
					"scope": "machine",
					"enum": [
						"default",
						"shadow",
						"advisory",
						"hard"
					],
					"enumDescriptions": [
						"Use the mode delivered for your account (the default).",
						"Never blocks; records what it would have blocked.",
						"Never blocks; the reason is surfaced to the agent as guidance.",
						"Blocks: an edit that leaves the file unparseable is reverted."
					],
					"default": "default",
					"markdownDescription": "STM-2541: local override for the post-edit lint gate, which reverts an edit that leaves the edited file unparseable. `default` follows the mode delivered for your account. **This can only make the gate stricter, never weaker.** Scope is `machine`, so it is set per install and a cloned workspace's `.vscode/settings.json` cannot switch a machine onto the destructive path. Intended for QA and dogfooding; the rollout control is the account-level flag."
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "npm run generate:branding && npm run check-types && npm run lint && node esbuild.js",
		"compile-standalone": "npm run check-types && npm run lint && node esbuild.js --standalone && node scripts/package-standalone.mjs",
		"compile-web-host": "npm run check-types && npm run lint && node esbuild.js --web-host",
		"compile-cloud-host": "npm run check-types && npm run lint && node esbuild.js --cloud-host && node scripts/package-cloud-host.mjs",
		"uninstall-cli": "rm -f \"${TC_INSTALL_DIR:-$HOME/.local/bin}/tc\" && rm -rf \"$HOME/.testcompanion/cli\" && echo \"✓ tc uninstalled.\"",
		"package-brain": "./package-brain.sh",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"package": "npm run generate:branding && npm run check-types && npm run build:webview && npm run lint && node esbuild.js --production",
		"protos": "node proto/build-proto.js && node scripts/generate-server-setup.mjs && prettier src/shared/proto src/core/controller webview-ui/src/services src/standalone/server-setup.ts --write --log-level silent",
		"compile-tests": "node ./scripts/build-tests.js",
		"watch-tests": "tsc -p . -w --outDir out",
		"check-types": "npm run protos && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
		"lint": "eslint src --ext ts && eslint webview-ui/src --ext ts && cd webview-ui && npm run lint",
		"format": "prettier . --check",
		"format:fix": "prettier . --write",
		"test": "npm run compile-tests && npm run compile && npm run compile-standalone && npm run lint && npm-run-all test:unit test:integration",
		"test:ci": "node scripts/test-ci.js",
		"test:integration": "vscode-test",
		"test:unit": "node scripts/run-unit-tests.js",
		"test:unit:file": "node scripts/run-unit-tests.js --no-config --extension ts --require ts-node/register --require source-map-support/register --require ./src/test/requires.ts",
		"test:unit:coverage": "c8 npm run test:unit",
		"test:coverage": "vscode-test --coverage --coverage-reporter lcovonly --coverage-reporter html --coverage-output coverage/integration",
		"check:patch-coverage": "node scripts/check-patch-coverage.js",
		"install:all": "npm install && cd webview-ui && npm install --ignore-scripts=false",
		"dev:webview": "cd webview-ui && npm run dev",
		"build:webview": "cd webview-ui && npm run build",
		"build:webview:eclipse": "cd webview-ui && npm run build:eclipse && cd .. && rm -rf eclipse/com.browserstack.testcompanion.eclipse/resources/webview && mkdir -p eclipse/com.browserstack.testcompanion.eclipse/resources/webview && cp -R webview-ui/build-eclipse/. eclipse/com.browserstack.testcompanion.eclipse/resources/webview/",
		"test:webview": "cd webview-ui && npm run test",
		"publish:marketplace": "vsce publish && ovsx publish",
		"publish:marketplace:prerelease": "vsce publish --pre-release && ovsx publish --pre-release",
		"prepare": "husky",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"docs": "cd docs && npx mintlify dev",
		"docs:check-links": "cd docs && npx mintlify broken-links",
		"docs:rename-file": "cd docs && npx mintlify rename",
		"generate:branding": "node generate-branding.js",
		"update:extension": "vsce package && code --install-extension test-companion-0.5.0.vsix",
		"package:smoke": "node scripts/package-smoke.mjs",
		"build:cli": "bash cli/scripts/build-cli.sh",
		"build:brain": "node esbuild.js --cli-host",
		"proto:gen": "buf generate --path proto/host --path proto/core --path proto/common.proto --path proto/ui.proto --path proto/testHub.proto --path proto/testManagement.proto --path proto/tests.proto --path proto/testReporting.proto --path proto/integrations.proto --path proto/raisePr.proto --path proto/file.proto --path proto/updates.proto --path proto/mcp.proto",
		"proto:lint": "buf lint"
	},
