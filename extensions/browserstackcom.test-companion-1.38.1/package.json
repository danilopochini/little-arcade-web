		"walkthroughs": [
			{
				"id": "test-companion-walkthrough",
				"title": "Get Started with Test Companion",
				"description": "AI testing assistant in your IDE",
				"steps": [
					{
						"id": "Sign-in",
						"title": "Sign in to BrowserStack",
						"description": "",
						"media": {
							"markdown": "walkthrough/step1.md"
						}
					},
					{
						"id": "customize-companion",
						"title": "Customize Your Companion",
						"description": "Tailor the AI's behavior and set up common inputs to ensure all generated output fits your project perfectly.",
						"media": {
							"markdown": "walkthrough/step2.md"
						}
					},
					{
						"id": "generate-test-cases",
						"title": "Generate Your Test Cases",
						"description": "Create comprehensive test cases quickly, either from your project documentation or by analyzing a live page. ",
						"media": {
							"markdown": "walkthrough/step3.md"
						}
					},
					{
						"id": "generate-tests",
						"title": "Generate Your Test",
						"description": "Turn those requirements or test cases into executable test scripts instantly.",
						"media": {
							"markdown": "walkthrough/step4.md"
						},
						"content": {
							"path": "walkthrough/step4.md"
						}
					},
					{
						"id": "fix-tests",
						"title": "Fix Your Tests",
						"description": "Eliminate flakiness and resolve broken tests without manual debugging. ",
						"media": {
							"markdown": "walkthrough/step5.md"
						}
					}
				]
			}
		],
